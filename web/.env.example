# Costwatch — copy to .env.local and fill in.
# Never commit .env or .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon (or publishable) key. Safe for the browser: Row Level Security
# protects all data. NEVER put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this deployment. Used for auth email links, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Continue with Google". Enable the Google provider in Supabase first.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
